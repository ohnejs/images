    "typecheck": "tsc"
  },
  "dependencies": {
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/node": "26.0.0",
    "oxfmt": "0.55.0",
    "oxlint": "1.70.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@11.5.1"
}
